# Куда писать SQLite-базу и загруженные картинки.
# Локально не задавать — по умолчанию ./data.
# На Railway: примонтировать Volume и задать DATA_DIR=/data
DATA_DIR=

# Ключ Claude API для ИИ-оформления текста (необязательно).
# Без ключа кнопка «Оформить черновик» просто копирует введённый текст —
# приложение работает, ИИ-полировка отключена.
# Взять на https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
